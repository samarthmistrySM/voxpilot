{
  "manifest_version": 3,
  "name": "VoxPilot",
  "version": "1.0",
  "description": "Voice-driven browser control",

  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],

  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "index.html"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "content/state.js",
        "content/messaging.js",
        "content/parser.js",
        "content/dom.js",
        "content/actions.js",
        "content/pipeline.js"
      ],
      "run_at": "document_idle"
    }
  ]
}